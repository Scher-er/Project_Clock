<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BalancoPatrimonial.App.Views.EmpresasPage"
             Title="Empresas">

    <Grid RowDefinitions="Auto, Auto, *" Padding="24" RowSpacing="16">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Empresas" Style="{StaticResource TituloPagina}"/>
            <Label Text="Empresas com balanços planilhados no sistema."
                   Style="{StaticResource SubtituloPagina}"/>
        </VerticalStackLayout>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Entry x:Name="txtPesquisa"
                           Placeholder="Pesquisar por nome, CNPJ ou grupo econômico..."/>
                </Border>
                <Button Grid.Column="1"
                        Text="Filtrar"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Grid.Column="2"
                        Text="+ Nova"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <!-- Lista (placeholder) -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="🏢" FontSize="48" HorizontalOptions="Center"/>
                <Label Text="Lista de empresas vazia"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                <Label Text="A integração com o banco MySQL será implementada na Fase 3."
                       Style="{StaticResource SubtituloPagina}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
