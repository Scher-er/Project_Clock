<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BalancoPatrimonial.App.Views.AreaTestesPage"
             Title="Área de Testes">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <Label Text="Área de Testes" Style="{StaticResource TituloPagina}"/>
            <Label Text="Faça um planilhamento de teste sem persistir no banco. Resultado pode ser baixado em Excel."
                   Style="{StaticResource SubtituloPagina}"/>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="🧪" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Área de testes de planilhamento"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="Implementação na Fase 7. Reutilizará a tela de planilhamento manual, mas sem persistência no MySQL — apenas exportação local pra Excel."
                           Style="{StaticResource SubtituloPagina}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
