<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BalancoPatrimonial.App.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Primary}">

    <Grid>
        <!-- Cartão central com o formulário de login -->
        <Border Style="{StaticResource Card}"
                MaximumWidthRequest="420"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="20">
            <VerticalStackLayout Spacing="18" Padding="10">

                <!-- Cabeçalho / Logo (placeholder por enquanto) -->
                <Label Text="📊"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="Balanço Patrimonial"
                       Style="{StaticResource TituloPagina}"
                       HorizontalOptions="Center"/>
                <Label Text="Análise de Crédito"
                       Style="{StaticResource SubtituloPagina}"
                       HorizontalOptions="Center"/>

                <BoxView HeightRequest="1"
                         Color="{StaticResource Border}"
                         Margin="0,10"/>

                <!-- Campo Login -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Usuário"
                           Style="{StaticResource LabelCampo}"/>
                    <Border Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Entry x:Name="txtLogin"
                               Placeholder="admin"
                               ReturnType="Next"
                               ReturnCommand="{Binding Source={x:Reference txtSenha}, Path=Focus}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Campo Senha -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Senha"
                           Style="{StaticResource LabelCampo}"/>
                    <Border Stroke="{StaticResource Border}"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Entry x:Name="txtSenha"
                               Placeholder="••••••"
                               IsPassword="True"
                               ReturnType="Go"
                               ReturnCommand="{Binding Source={x:Reference btnEntrar}, Path=Command}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Mensagem de erro -->
                <Label x:Name="lblErro"
                       TextColor="{StaticResource Danger}"
                       FontSize="13"
                       IsVisible="False"
                       HorizontalOptions="Center"/>

                <!-- Botão Entrar -->
                <Button x:Name="btnEntrar"
                        Text="ENTRAR"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnEntrarClicked"
                        Margin="0,8,0,0"/>

                <!-- Loading -->
                <ActivityIndicator x:Name="loading"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="{StaticResource Primary}"/>

                <Label Text="Use admin / admin para testar (Fase 1)"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
