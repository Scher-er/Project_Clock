<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BalancoPatrimonial.App.ViewModels"
             x:DataType="viewmodels:RevisaoImportacaoViewModel"
             x:Class="BalancoPatrimonial.App.Views.RevisaoImportacaoPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *, Auto">

        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="24,16">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Title}" Style="{StaticResource TituloPagina}"/>
                <Label Text="{Binding Subtitulo}" Style="{StaticResource SubtituloPagina}"/>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" Padding="24,12">
            <VerticalStackLayout x:Name="layoutRevisao" Spacing="16"/>
        </ScrollView>

        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="24,12">
            <Button Text="Continuar para o planilhamento"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="44"
                    Command="{Binding ContinuarCommand}"/>
        </Border>
    </Grid>
</ContentPage>
