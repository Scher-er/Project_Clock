<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BalancoPatrimonial.App.Views.Items"
             x:Class="BalancoPatrimonial.App.Views.LogsPage"
             Title="Logs">

    <Grid RowDefinitions="Auto, Auto, *" Padding="24" RowSpacing="16">

        <!-- Cabeçalho -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Logs do Sistema" Style="{StaticResource TituloPagina}"/>
            <Label x:Name="lblSubtitulo"
                   Text="Eventos registrados — armazenados em MongoDB + TXT diário."
                   Style="{StaticResource SubtituloPagina}"/>
        </VerticalStackLayout>

        <!-- Filtros -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="12" RowSpacing="6">
                <Label Grid.Column="0"
                       Text="Data:"
                       VerticalOptions="Center"
                       Style="{StaticResource LabelCampo}"/>
                <Border Grid.Column="1" Style="{StaticResource PickerBorder}">
                    <DatePicker x:Name="dpData"
                                Format="dd/MM/yyyy"
                                DateSelected="OnDataSelecionada"/>
                </Border>
                <BoxView Grid.Column="2" Color="Transparent"/>
                <Button Grid.Column="3"
                        Text="Recarregar"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnRecarregarClicado"/>
                <Button Grid.Column="4"
                        Text="Exportar XML"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnExportarClicado"/>
            </Grid>
        </Border>

        <!-- Lista -->
        <RefreshView Grid.Row="2"
                     x:Name="refreshView"
                     Refreshing="OnRecarregar">
            <Grid>
                <Border x:Name="painelVazio"
                        Style="{StaticResource Card}"
                        IsVisible="false">
                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="" FontSize="48" HorizontalOptions="Center"/>
                        <Label x:Name="lblMensagemVazia"
                               Text="Nenhum log para esta data."
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Use a Área de Testes para gerar logs de demonstração."
                               Style="{StaticResource SubtituloPagina}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <CollectionView x:Name="lvLogs"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogListItem">
                            <Border Style="{StaticResource Card}"
                                    Padding="14"
                                    Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">

                                    <!-- Hora + emoji -->
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="2"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Emoji}"
                                               FontSize="20"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding Hora}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>

                                    <!-- Conteúdo -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{Binding CorTipo}"
                                                    Padding="8,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Tipo}"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"/>
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Acao}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   VerticalOptions="Center"/>
                                            <Label Grid.Column="2"
                                                   Text="{Binding Usuario}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                        <Label Text="{Binding Descricao}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>

    </Grid>
</ContentPage>
