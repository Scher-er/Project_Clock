<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BalancoPatrimonial.App.Views.DetalheBalancoPage"
             Title="Detalhe do Balanço">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="0">

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="24,16">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="lblTitulo" Text="Balanço" Style="{StaticResource TituloPagina}"/>
                <Label x:Name="lblSubtitulo" Text="Carregando..." Style="{StaticResource SubtituloPagina}"/>
            </VerticalStackLayout>
        </Border>

        <!-- Abas: Balanço | DRE -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="24,0,24,8">
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="btnAbaBalanco" Text="Balanço Patrimonial"
                        HeightRequest="38" WidthRequest="190" CornerRadius="8"
                        Clicked="OnVerBalancoClicado"/>
                <Button x:Name="btnAbaDre" Text="DRE"
                        HeightRequest="38" WidthRequest="130" CornerRadius="8"
                        Clicked="OnVerDreClicado"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Conteúdo (largura limitada e centralizada pra não espalhar em telas largas) -->
        <ScrollView Grid.Row="2" Padding="24,12">
            <Grid>
                <VerticalStackLayout x:Name="layoutContas" Spacing="0"
                                     MaximumWidthRequest="820" HorizontalOptions="Center"/>
                <VerticalStackLayout x:Name="layoutDre" Spacing="0" IsVisible="False"
                                     MaximumWidthRequest="640" HorizontalOptions="Center"/>
            </Grid>
        </ScrollView>

        <!-- Rodapé: totais + ações -->
        <Border Grid.Row="3"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="24,12">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="0">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label x:Name="lblTotais" Text="" FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                    <Label x:Name="lblStatus" Text="" FontSize="12" FontAttributes="Bold"/>
                </VerticalStackLayout>

                <Button Grid.Column="1" x:Name="btnExportar" Text="Exportar"
                        Style="{StaticResource SecondaryButton}"
                        WidthRequest="110" HeightRequest="40"
                        Clicked="OnExportarClicado"/>
                <Button Grid.Column="2" x:Name="btnExcluir" Text="Excluir"
                        Style="{StaticResource DangerButton}"
                        WidthRequest="100" HeightRequest="40"
                        Clicked="OnExcluirClicado"/>
                <Button Grid.Column="3" x:Name="btnSalvar" Text="Salvar alterações"
                        Style="{StaticResource PrimaryButton}"
                        WidthRequest="160" HeightRequest="40"
                        Clicked="OnSalvarClicado"/>
                <Button Grid.Column="4" Text="Fechar"
                        Style="{StaticResource SecondaryButton}"
                        WidthRequest="100" HeightRequest="40"
                        Clicked="OnFecharClicado"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
