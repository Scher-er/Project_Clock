<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BalancoPatrimonial.App.Models"
             xmlns:items="clr-namespace:BalancoPatrimonial.App.Views.Items"
             xmlns:viewmodels="clr-namespace:BalancoPatrimonial.App.ViewModels"
             x:DataType="viewmodels:CadastroEmpresaViewModel"
             x:Class="BalancoPatrimonial.App.Views.CadastroEmpresaPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}"
                       Style="{StaticResource TituloPagina}"/>
                <Label Text="{Binding Subtitulo}"
                       Style="{StaticResource SubtituloPagina}"/>
            </VerticalStackLayout>

            <!-- Dados básicos -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Dados básicos" FontAttributes="Bold" FontSize="15"/>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="CNPJ *" Style="{StaticResource LabelCampo}"/>
                        <Entry Text="{Binding Cnpj}"
                               Placeholder="00.000.000/0000-00"
                               Keyboard="Numeric"
                               MaxLength="18"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Razão Social *" Style="{StaticResource LabelCampo}"/>
                        <Entry Text="{Binding RazaoSocial}" Placeholder="Nome jurídico da empresa"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nome Fantasia" Style="{StaticResource LabelCampo}"/>
                        <Entry Text="{Binding NomeFantasia}" Placeholder="Nome comercial"/>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="UF" Style="{StaticResource LabelCampo}"/>
                            <Entry Text="{Binding Uf}" Placeholder="SP" MaxLength="2"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Local de atuação" Style="{StaticResource LabelCampo}"/>
                            <Entry Text="{Binding LocalAtuacao}" Placeholder="Nacional / Regional / Sudeste..."/>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Tipo da empresa" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource PickerBorder}">
                            <Picker ItemsSource="{Binding Tipos}"
                                    SelectedItem="{Binding TipoSelecionado}"
                                    ItemDisplayBinding="{Binding Nome}"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Análise de crédito -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Análise de crédito" FontAttributes="Bold" FontSize="15"/>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Rating" Style="{StaticResource LabelCampo}"/>
                            <Border Style="{StaticResource PickerBorder}">
                                <Picker ItemsSource="{Binding Ratings}"
                                        SelectedItem="{Binding RatingSelecionado}"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Limite de crédito (R$)" Style="{StaticResource LabelCampo}"/>
                            <Entry Text="{Binding LimiteCredito}"
                                   Placeholder="0,00"
                                   Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Grupo econômico" Style="{StaticResource LabelCampo}"/>
                        <Border Style="{StaticResource PickerBorder}">
                            <Picker ItemsSource="{Binding Grupos}"
                                    SelectedItem="{Binding GrupoSelecionado}"
                                    ItemDisplayBinding="{Binding Nome}"/>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Setores (N:N) -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Setores de atuação"
                               FontAttributes="Bold"
                               FontSize="15"/>
                        <Label Grid.Column="1"
                               Text="{Binding ContagemSetores}"
                               Style="{StaticResource SubtituloPagina}"/>
                    </Grid>

                    <Label Text="Marque um ou mais setores. O primeiro marcado vira o principal."
                           Style="{StaticResource SubtituloPagina}"/>

                    <!-- Lista de setores com checkbox -->
                    <CollectionView ItemsSource="{Binding Setores}"
                                    SelectedItems="{Binding SetoresSelecionados}"
                                    SelectionMode="Multiple"
                                    HeightRequest="220">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SetorAtividade">
                                <Grid ColumnDefinitions="Auto, *" Padding="4,6" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Codigo}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Nome}"
                                           FontSize="14"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Balanços planilhados (só aparece em modo edição) -->
            <!-- Balanços planilhados (só aparece em modo edição) -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding TemBalancos}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Balanços planilhados"
                               FontAttributes="Bold"
                               FontSize="15"/>
                        <Label Grid.Column="1"
                               Text="{Binding QtdBalancos}"
                               Style="{StaticResource SubtituloPagina}"/>
                    </Grid>

                    <Label Text="Cada balanço pode ser exportado em Excel (planilha contábil), PDF (relatório executivo) ou JSON (integração com outros sistemas)."
                           Style="{StaticResource SubtituloPagina}"/>

                    <CollectionView ItemsSource="{Binding Balancos}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="items:BalancoListItem">
                                <Border Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                                        StrokeThickness="1"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                    <Grid RowDefinitions="Auto, Auto"
                                          ColumnDefinitions="Auto, *, Auto"
                                          ColumnSpacing="12"
                                          RowSpacing="6">

                                        <!-- Linha 1: identificação -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Ano}"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               VerticalOptions="Center"/>

                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                            <Border BackgroundColor="{Binding CorBadgeTipo}"
                                                    Padding="8,2"
                                                    HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding TipoTexto}"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"/>
                                            </Border>
                                            <Label Text="{Binding DataPlanilhamento, StringFormat='Planilhado em {0}'}"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Row="0" Grid.Column="2"
                                               Text="{Binding IconeOrigem}"
                                               FontSize="20"
                                               VerticalOptions="Center"/>

                                        <!-- Linha 2: botões de exportação -->
                                        <Grid Grid.Row="1" Grid.ColumnSpan="3"
                                              ColumnDefinitions="*, *, *"
                                              ColumnSpacing="6">
                                            <Button Grid.Column="0"
                                                    Text="Excel"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HeightRequest="36"
                                                    FontSize="13"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CadastroEmpresaViewModel}}, Path=ExportarCommand}"
                                                    CommandParameter="Excel"/>
                                            <Button Grid.Column="1"
                                                    Text="PDF"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HeightRequest="36"
                                                    FontSize="13"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CadastroEmpresaViewModel}}, Path=ExportarCommand}"
                                                    CommandParameter="PDF"/>
                                            <Button Grid.Column="2"
                                                    Text="JSON"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HeightRequest="36"
                                                    FontSize="13"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CadastroEmpresaViewModel}}, Path=ExportarCommand}"
                                                    CommandParameter="JSON"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- Ações -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelarCommand}"/>
                <Button Grid.Column="1"
                        Text="Salvar"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SalvarCommand}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
