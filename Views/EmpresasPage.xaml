<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BalancoPatrimonial.App.Views.Items"
             xmlns:viewmodels="clr-namespace:BalancoPatrimonial.App.ViewModels"
             x:DataType="viewmodels:EmpresasViewModel"
             x:Class="BalancoPatrimonial.App.Views.EmpresasPage"
             Title="Empresas">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Importar JSON" Command="{Binding ImportarJsonCommand}"/>
    </ContentPage.ToolbarItems>

        <Grid>
        <Grid RowDefinitions="Auto, Auto, *" Padding="24" RowSpacing="16">

        <!-- Cabeçalho -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Empresas" Style="{StaticResource TituloPagina}"/>
            <Label Text="{Binding Subtitulo}"
                   Style="{StaticResource SubtituloPagina}"/>
        </VerticalStackLayout>

        <!-- Barra de filtros -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                        StrokeThickness="1"
                        Padding="10,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding TextoPesquisa}"
                           Placeholder="Pesquisar por nome, CNPJ ou grupo econômico..."
                           ReturnType="Search"
                           ReturnCommand="{Binding PesquisarCommand}"/>
                </Border>
                <Button Grid.Column="1"
                        Text="Filtrar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding PesquisarCommand}"/>
                <Button Grid.Column="2"
                        Text="+ Nova"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NovaEmpresaCommand}"/>
            </Grid>
        </Border>

        <!-- Lista -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RecarregarCommand}">

            <Grid>
                <!-- Estado vazio -->
                <Border Style="{StaticResource Card}"
                        IsVisible="{Binding TemMensagemVazia}">
                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="{Binding MensagemVazia}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label Text="Use o botão '+ Nova' para cadastrar a primeira."
                               Style="{StaticResource SubtituloPagina}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- CollectionView -->
                <CollectionView ItemsSource="{Binding Items}"
                                IsVisible="{Binding ListaVisivel}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EmpresaListItem">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Excluir"
                                                   BackgroundColor="{StaticResource Danger}"
                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EmpresasViewModel}}, Path=ExcluirCommand}"
                                                   CommandParameter="{Binding Id}"/>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Style="{StaticResource Card}"
                                        Margin="0,0,0,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EmpresasViewModel}}, Path=EditarEmpresaCommand}"
                                            CommandParameter="{Binding Id}"/>
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="Auto, Auto, Auto, Auto"
                                          ColumnDefinitions="*, Auto"
                                          RowSpacing="6">

                                        <!-- Razão social + rating -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding RazaoSocial}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                        <Border Grid.Row="0" Grid.Column="1"
                                                BackgroundColor="{Binding CorRating}"
                                                Padding="10,4"
                                                IsVisible="{Binding TemRating}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Rating}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   FontAttributes="Bold"/>
                                        </Border>

                                        <!-- CNPJ + UF + Grupo -->
                                        <Label Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding LinhaIdentificacao}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>

                                        <!-- Setor + Limite -->
                                        <Label Grid.Row="2" Grid.ColumnSpan="2"
                                               Text="{Binding LinhaSetorLimite}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>

                                        <!-- Balanços + botão de visualização -->
                                        <Grid Grid.Row="3" Grid.ColumnSpan="2"
                                              ColumnDefinitions="*, Auto"
                                              ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                                   Text="{Binding LinhaBalancos}"
                                                   FontSize="12"
                                                   FontAttributes="Italic"
                                                   VerticalOptions="Center"
                                                   TextColor="{StaticResource Primary}"/>
                                            <Button Grid.Column="1"
                                                    Text="Ver Balanços"
                                                    FontSize="12"
                                                    HeightRequest="32"
                                                    Padding="12,0"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:EmpresasViewModel}}, Path=VerBalancosCommand}"
                                                    CommandParameter="{Binding Id}"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>
    </Grid>

        <!-- LOADING OVERLAY -->
        <Grid BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}" 
              IsVisible="{Binding IsBusy}"
              ZIndex="100">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" Color="#1F6FEB" WidthRequest="48" HeightRequest="48"/>
                <Label Text="Carregando..." TextColor="{AppThemeBinding Light=#111, Dark=#FFF}" FontAttributes="Bold" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
