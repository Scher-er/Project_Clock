<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BalancoPatrimonial.App.Models"
             x:Class="BalancoPatrimonial.App.Views.PlanilhamentoPage"
             Title="Planilhamento">

    <!--
        Estrutura de rows:
          0 = Cabeçalho
          1 = Barra Empresa + Ações
          2 = Painel de resultados da busca de empresa (overlay-like)
          3 = Painel "+ Novo Período" (oculto por padrão)
          4 = Chips dos períodos ativos
          5 = Tabela (*)
          6 = Rodapé
    -->
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto" Padding="0">

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="32,16,32,12">
            <VerticalStackLayout Spacing="2">
                <Label Text="Planilhamento de Balanço" Style="{StaticResource TituloPagina}"/>
                <Label x:Name="lblSubtitulo"
                       Text="Adicione um ou mais períodos. Cada período aparece como uma coluna na tabela."
                       Style="{StaticResource SubtituloPagina}"/>
            </VerticalStackLayout>
        </Border>

        <!-- Barra principal: Empresa (busca) + Ações -->
        <Border Grid.Row="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="32,8,32,12">
            <Grid ColumnDefinitions="2*, Auto, Auto, Auto, Auto"
                  ColumnSpacing="12"
                  RowSpacing="6">

                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="EMPRESA" Style="{StaticResource LabelCampo}"/>
                    <!--
                        Busca por texto em vez de Picker (que tem bug conhecido
                        no MAUI Windows pra mostrar item selecionado).
                        Resultados aparecem na row 2 abaixo.
                    -->
                    <Border Style="{StaticResource PickerBorder}">
                        <Entry x:Name="txtBuscaEmpresa"
                               BackgroundColor="Transparent"
                               Placeholder="Buscar empresa por nome ou CNPJ..."
                               VerticalOptions="Fill"
                               TextChanged="OnBuscaEmpresaChanged"
                               Focused="OnBuscaEmpresaFocused"/>
                    </Border>
                </VerticalStackLayout>

                <Button Grid.Column="1" Text="+ Período"
                        Style="{StaticResource SecondaryButton}"
                        VerticalOptions="End" WidthRequest="110"
                        Clicked="OnAdicionarPeriodoClicado"/>

                <Button Grid.Column="2" Text="Importar PDF"
                        Style="{StaticResource SecondaryButton}"
                        VerticalOptions="End" WidthRequest="130"
                        Clicked="OnImportarPdfClicado"/>

                <Button Grid.Column="3" Text="Importar com IA"
                        Style="{StaticResource PrimaryButton}"
                        VerticalOptions="End" WidthRequest="150"
                        Clicked="OnImportarPdfComIaClicado"/>

                <Button Grid.Column="4" Text="Limpar"
                        Style="{StaticResource SecondaryButton}"
                        VerticalOptions="End" WidthRequest="90"
                        Clicked="OnLimparClicado"/>
            </Grid>
        </Border>

        <!--
            ROW 2: Painel de resultados da busca de empresa.
            Aparece logo abaixo do campo de busca, ocupando 60% da largura
            (alinhado com o campo "EMPRESA"). Toggleable.
        -->
        <Border Grid.Row="2"
                x:Name="painelResultadosEmpresa"
                Margin="32,0,32,8"
                HorizontalOptions="Start"
                WidthRequest="500"
                StrokeShape="RoundRectangle 4"
                Stroke="{AppThemeBinding Light={StaticResource BorderStrong}, Dark={StaticResource BorderStrongDark}}"
                StrokeThickness="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="0"
                IsVisible="False">
            <CollectionView x:Name="lvResultadosEmpresa"
                            HeightRequest="220"
                            SelectionMode="Single"
                            SelectionChanged="OnEmpresaResultadoSelecionado">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Empresa">
                        <Grid Padding="14,10" ColumnDefinitions="*">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding RazaoSocial}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Cnpj}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Nenhuma empresa encontrada com esse termo."
                           Padding="14,10"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </Border>

        <!-- Painel de adicionar período -->
        <Border Grid.Row="3"
                x:Name="painelAddPeriodo"
                BackgroundColor="{AppThemeBinding Light=#EEF2F7, Dark=#243140}"
                Padding="32,12,32,16"
                IsVisible="False">
            <Grid ColumnDefinitions="Auto, *, *, *, Auto, Auto" ColumnSpacing="12"
                  RowSpacing="6" VerticalOptions="End">

                <Label Grid.Column="0" Text="NOVO PERÍODO:"
                       Style="{StaticResource LabelCampo}"
                       VerticalOptions="End" Margin="0,0,8,12"/>

                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="ANO" Style="{StaticResource LabelCampo}"/>
                    <Border Style="{StaticResource PickerBorder}">
                        <Picker x:Name="pkAddAno" BackgroundColor="Transparent" VerticalOptions="Fill"/>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="4">
                    <Label Text="MÊS (OPCIONAL)" Style="{StaticResource LabelCampo}"/>
                    <Border Style="{StaticResource PickerBorder}">
                        <Picker x:Name="pkAddMes" BackgroundColor="Transparent" VerticalOptions="Fill">
                            <Picker.Items>
                                <x:String>Ano inteiro</x:String>
                                <x:String>Janeiro</x:String>
                                <x:String>Fevereiro</x:String>
                                <x:String>Março</x:String>
                                <x:String>Abril</x:String>
                                <x:String>Maio</x:String>
                                <x:String>Junho</x:String>
                                <x:String>Julho</x:String>
                                <x:String>Agosto</x:String>
                                <x:String>Setembro</x:String>
                                <x:String>Outubro</x:String>
                                <x:String>Novembro</x:String>
                                <x:String>Dezembro</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="4">
                    <Label Text="TIPO" Style="{StaticResource LabelCampo}"/>
                    <Border Style="{StaticResource PickerBorder}">
                        <Picker x:Name="pkAddTipo" BackgroundColor="Transparent" VerticalOptions="Fill">
                            <Picker.Items>
                                <x:String>Individual</x:String>
                                <x:String>Consolidado</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </VerticalStackLayout>

                <Button Grid.Column="4" Text="Adicionar"
                        Style="{StaticResource PrimaryButton}"
                        VerticalOptions="End" WidthRequest="110"
                        Clicked="OnConfirmarAdicionarPeriodo"/>

                <Button Grid.Column="5" Text="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        VerticalOptions="End" WidthRequest="100"
                        Clicked="OnCancelarAdicionarPeriodo"/>
            </Grid>
        </Border>

        <!-- Chips dos períodos ativos -->
        <Border Grid.Row="4"
                x:Name="painelChips"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="32,6"
                IsVisible="False">
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout x:Name="layoutChips" Spacing="8"/>
            </ScrollView>
        </Border>

        <!-- Corpo da tabela (card centralizado) -->
        <ScrollView Grid.Row="5" Orientation="Vertical">
            <Border Margin="20,8"
                    StrokeShape="RoundRectangle 6"
                    Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Start">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Default">
                    <Grid x:Name="gridTabela"
                          ColumnSpacing="0"
                          RowSpacing="0"
                          Padding="0"
                          HorizontalOptions="Center"/>
                </ScrollView>
            </Border>
        </ScrollView>

        <!-- Rodapé -->
        <Border Grid.Row="6"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                Padding="24,8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" RowSpacing="0">

                <ScrollView Grid.Column="0" Orientation="Horizontal">
                    <VerticalStackLayout x:Name="layoutKPIs"
                                         Spacing="2"
                                         VerticalOptions="Center"/>
                </ScrollView>

                <Button Grid.Column="1"
                        x:Name="btnSalvar"
                        Text="Salvar Balanços"
                        Style="{StaticResource PrimaryButton}"
                        VerticalOptions="Center"
                        WidthRequest="160"
                        HeightRequest="40"
                        Clicked="OnSalvarClicado"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
