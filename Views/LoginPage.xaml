<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:BalancoPatrimonial.App.ViewModels"
             x:DataType="viewmodels:LoginViewModel"
             x:Class="BalancoPatrimonial.App.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Primary}">

    <Grid>
        <!-- Cartão central com o formulário de login -->
        <Border Style="{StaticResource Card}"
                MaximumWidthRequest="420"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="20">
            <VerticalStackLayout Spacing="18" Padding="10">

                <!-- Logo do sistema -->
                <Image Source="logo.png"
                       HeightRequest="84"
                       WidthRequest="84"
                       HorizontalOptions="Center"/>
                <Label Text="Balanço Patrimonial"
                       Style="{StaticResource TituloPagina}"
                       HorizontalOptions="Center"/>
                <Label Text="Análise de Crédito"
                       Style="{StaticResource SubtituloPagina}"
                       HorizontalOptions="Center"/>

                <BoxView HeightRequest="1"
                         Color="{StaticResource Border}"
                         Margin="0,10"/>

                <!-- Campo Login -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Usuário"
                           Style="{StaticResource LabelCampo}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Entry x:Name="txtLogin"
                               Text="{Binding Login}"
                               IsEnabled="{Binding IsNotBusy}"
                               Placeholder="admin"
                               ReturnType="Next"
                               Completed="OnLoginCompleted"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Campo Senha -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Senha"
                           Style="{StaticResource LabelCampo}"/>
                    <Border Stroke="{AppThemeBinding Light={StaticResource Border}, Dark={StaticResource BorderDark}}"
                            StrokeThickness="1"
                            Padding="10,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>
                        <Entry x:Name="txtSenha"
                               Text="{Binding Senha}"
                               IsEnabled="{Binding IsNotBusy}"
                               Placeholder="••••••••"
                               IsPassword="True"
                               ReturnType="Go"
                               ReturnCommand="{Binding EntrarCommand}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Mensagem de erro -->
                <Label Text="{Binding ErroMensagem}"
                       TextColor="{StaticResource Danger}"
                       FontSize="13"
                       IsVisible="{Binding TemErro}"
                       HorizontalOptions="Center"/>

                <!-- Botão Entrar -->
                <Button Text="ENTRAR"
                        Command="{Binding EntrarCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,8,0,0"/>

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"/>

                <Label Text="Use admin / admin para testar (Fase 1)"
                       FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource TextMuted}, Dark={StaticResource TextMutedDark}}"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
