<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BalancoPatrimonial.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BalancoPatrimonial.App.Views"
    Shell.FlyoutBehavior="Locked"
    Shell.FlyoutWidth="230"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light=#1F3A60, Dark=#0F1620}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.NavBarHasShadow="False"
    Title="Project Clock">

    <!-- Cabeçalho do sidebar -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="110"
              BackgroundColor="#13243D"
              Padding="18,16">
            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                <Label Text="Project Clock"
                       TextColor="White"
                       FontSize="17"
                       FontAttributes="Bold"/>
                <Label Text="Balanço Patrimonial"
                       TextColor="#8A93A6"
                       FontSize="11"/>
                <Label x:Name="lblUsuarioLogado"
                       Text="—"
                       TextColor="#C9A14A"
                       FontSize="12"
                       FontAttributes="Bold"
                       Margin="0,6,0,0"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!--
        ContentTemplate é atribuído no code-behind via DI.
        NÃO usar ContentTemplate no XAML — as páginas têm construtores DI.
    -->
    <FlyoutItem Title="Dashboard" Route="dashboard">
        <ShellContent x:Name="scDashboard" />
    </FlyoutItem>

    <FlyoutItem Title="Empresas" Route="empresas">
        <ShellContent x:Name="scEmpresas" />
    </FlyoutItem>

    <FlyoutItem Title="Planilhamento" Route="planilhamento">
        <ShellContent x:Name="scPlanilhamento" />
    </FlyoutItem>

    <FlyoutItem Title="Análises" Route="analises">
        <ShellContent x:Name="scAnalises" />
    </FlyoutItem>

    <FlyoutItem Title="Comparar" Route="comparar">
        <ShellContent x:Name="scComparacao" />
    </FlyoutItem>

    <FlyoutItem Title="Logs" Route="logs">
        <ShellContent x:Name="scLogs" />
    </FlyoutItem>

    <FlyoutItem Title="Configurações" Route="testes">
        <ShellContent x:Name="scTestes" />
    </FlyoutItem>

    <MenuItem Text="Sair" Clicked="OnLogoutClicked" />

</Shell>
