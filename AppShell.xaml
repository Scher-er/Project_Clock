<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BalancoPatrimonial.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:BalancoPatrimonial.App.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource SidebarBackground}, Dark={StaticResource SidebarBackgroundDark}}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    FlyoutWidth="260"
    Title="Balanço Patrimonial">

    <!-- Cabeçalho do sidebar (mostra o usuário logado) -->
    <Shell.FlyoutHeader>
        <Grid HeightRequest="140"
              BackgroundColor="{StaticResource Primary}"
              Padding="20">
            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                <Label Text="Balanço Patrimonial"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"/>
                <Label Text="Análise de Crédito"
                       TextColor="{StaticResource TextMuted}"
                       FontSize="12"/>
                <Label x:Name="lblUsuarioLogado"
                       Text="—"
                       TextColor="White"
                       FontSize="13"
                       Margin="0,12,0,0"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Estilo dos itens do flyout -->
    <Shell.Resources>
        <Style x:Key="BaseStyle" TargetType="Element">
            <Setter Property="Shell.BackgroundColor" Value="{StaticResource Primary}" />
            <Setter Property="Shell.ForegroundColor" Value="White" />
            <Setter Property="Shell.TitleColor" Value="White" />
            <Setter Property="Shell.NavBarHasShadow" Value="False" />
        </Style>
        <Style TargetType="ShellContent" BasedOn="{StaticResource BaseStyle}" />
        <Style TargetType="FlyoutItem" BasedOn="{StaticResource BaseStyle}" />
    </Shell.Resources>

    <!--
        IMPORTANTE: os ShellContents abaixo NÃO definem ContentTemplate aqui.
        O code-behind do AppShell atribui os templates via DI (App.Services)
        no construtor. Sem isso, o MAUI tenta instanciar as páginas via
        Activator.CreateInstance que falha porque as pages têm construtores
        com parâmetros (injeção de dependência).
    -->
    <FlyoutItem Title="Planilhamento" Route="planilhamento">
        <ShellContent x:Name="scPlanilhamento" />
    </FlyoutItem>

    <FlyoutItem Title="Empresas" Route="empresas">
        <ShellContent x:Name="scEmpresas" />
    </FlyoutItem>

    <FlyoutItem Title="Análises" Route="analises">
        <ShellContent x:Name="scAnalises" />
    </FlyoutItem>

    <FlyoutItem Title="Comparar" Route="comparar">
        <ShellContent x:Name="scComparacao" />
    </FlyoutItem>

    <FlyoutItem Title="Logs" Route="logs">
        <ShellContent x:Name="scLogs" />
    </FlyoutItem>

    <FlyoutItem Title="Área de Testes" Route="testes">
        <ShellContent x:Name="scTestes" />
    </FlyoutItem>

    <!-- Item de logout no rodapé do flyout -->
    <MenuItem Text="Sair" Clicked="OnLogoutClicked" />

</Shell>
